# IBM Granite / watsonx.ai Credentials
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git

# IBM watsonx.ai API base URL
# e.g. https://us-south.ml.cloud.ibm.com
GRANITE_API_URL=

# IBM watsonx.ai API key (IAM key from IBM Cloud)
GRANITE_API_KEY=

# IBM Granite model ID to use
# e.g. ibm/granite-3-3-8b-instruct  or  ibm/granite-13b-instruct-v2
GRANITE_MODEL=ibm/granite-3-3-8b-instruct

# ── NOTES ──────────────────────────────────────────────────────────────
# 1. Get your API key from: https://cloud.ibm.com/iam/apikeys
# 2. Get your project URL from: https://us-south.ml.cloud.ibm.com
# 3. The app runs in rule-based DEMO MODE when GRANITE_API_KEY is empty.
# 4. See README.md for full setup instructions.
